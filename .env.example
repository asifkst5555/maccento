APP_NAME=maccento
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=admin@example.com
MAIL_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="admin@example.com"
MAIL_FROM_NAME="${APP_NAME}"
INBOUND_MAIL_ENABLED=true
INBOUND_MAIL_PROVIDER=imap
INBOUND_MAIL_HOST=mail.example.com
INBOUND_MAIL_PORT=993
INBOUND_MAIL_ENCRYPTION=ssl
INBOUND_MAIL_USERNAME=admin@example.com
INBOUND_MAIL_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD
INBOUND_MAIL_MAILBOX=INBOX
INBOUND_MAIL_SEARCH=UNSEEN
INBOUND_MAIL_MAX_PER_RUN=50
INBOUND_MAIL_DELETE_AFTER_PROCESS=false
LEAD_ALERT_EMAIL="alerts@example.com"
QUOTE_ADMIN_EMAIL="ops@example.com"
SENDGRID_WEBHOOK_SIGNING_KEY=REPLACE_WITH_SENDGRID_EVENT_PUBLIC_KEY
SENDGRID_INBOUND_WEBHOOK_TOKEN=REPLACE_WITH_SENDGRID_INBOUND_TOKEN

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Payment demo mode (true uses mock success if keys missing)
PAYMENTS_DEMO_MODE=true

MEDIA_DISK=public
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PATH_STYLE=false

OUTBOUND_WEBHOOK_ENABLED=false
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=

RETENTION_REQUEST_EDIT_LOGS_DAYS=365
RETENTION_EMAIL_LOGS_DAYS=365
RETENTION_WEBHOOK_LOGS_DAYS=90
RETENTION_NOTIFICATIONS_DAYS=90

SYSTEM_HEALTH_FAILED_JOBS_THRESHOLD=1
SYSTEM_HEALTH_FAILED_EMAIL_THRESHOLD=1
SYSTEM_HEALTH_SENDGRID_FAIL_THRESHOLD=1
SYSTEM_HEALTH_BACKUP_MAX_AGE_DAYS=2
SYSTEM_HEALTH_BACKUP_KEEP=30
SYSTEM_HEALTH_BACKUP_MYSQLDUMP_PATH=
SYSTEM_HEALTH_BACKUP_MYSQL_PATH=

